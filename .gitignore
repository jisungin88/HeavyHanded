# =============================================================================
# HEAVY HANDED — Unreal Engine 5.4 .gitignore
#
# 원칙: 엔진이 "다시 생성할 수 있는 것"은 전부 제외한다.
#       추적 대상은 .uproject / Config / Content / Source / Plugins(소스) / Docs 뿐.
#
# 주의: 이 파일에 추가하기 전에 이미 커밋된 파일은 무시되지 않는다.
#       실수로 커밋했다면: git rm -r --cached <경로> 후 다시 커밋할 것.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 언리얼 엔진 생성 폴더 (절대 커밋 금지 — 용량 폭탄의 주범)
# -----------------------------------------------------------------------------
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# 플러그인 내부 생성물 (플러그인 소스 자체는 추적한다)
Plugins/**/Binaries/
Plugins/**/Build/
Plugins/**/Intermediate/

# 패키징 결과물
[Pp]ackaged/
[Dd]ist/
Builds/

# -----------------------------------------------------------------------------
# 2. IDE / 툴 설정
# -----------------------------------------------------------------------------
# Visual Studio
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Rider / JetBrains
.idea/
*.sln.DotSettings.user

# Visual Studio Code
# .vscode/ 는 팀 공통 설정을 공유하고 싶다면 아래 주석을 해제하고 예외를 둘 것
.vscode/

# Xcode (Mac 작업자 대비)
*.xcodeproj/
*.xcworkspace/

# -----------------------------------------------------------------------------
# 3. OS 생성 파일
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# -----------------------------------------------------------------------------
# 4. 언리얼 임시 / 백업 / 충돌 파일
# -----------------------------------------------------------------------------
# 에디터 자동 저장 및 크래시 백업
*.autosave
*.tmp
*.temp
*.bak
*.backup

# uasset 저장 중 생성되는 임시 파일
*.uasset.tmp
*.umap.tmp

# 에디터 크래시 리포트
CrashReportClient/

# -----------------------------------------------------------------------------
# 5. 개인 설정 파일 (사람마다 달라서 충돌만 유발)
# -----------------------------------------------------------------------------
# Saved/ 안에 있으므로 이미 제외되지만 명시적으로 한 번 더
Config/**/EditorPerProjectUserSettings.ini
*.uecfg

# -----------------------------------------------------------------------------
# 6. 대용량 원본 소스 파일 (DCC 원본은 별도 클라우드에 보관)
#    - 최종 export된 fbx/png 만 Content/ 에 넣고, 원본은 여기서 제외한다.
#    - 팀에서 원본까지 LFS로 관리하기로 했다면 이 블록을 삭제할 것.
# -----------------------------------------------------------------------------
RawAssets/
*.blend1
*.blend2
*.max
*.ma
*.mb
*.psd
*.psb
*.aep
*.zpr
*.ztl

# -----------------------------------------------------------------------------
# 7. 기타
# -----------------------------------------------------------------------------
*.log
*.zip
*.rar
*.7z
.claude/settings.local.json
